# ===================== TREO BOT =====================
app = Flask('')
@app.route('/')
def home(): return "✅ BOT ĐANG HOẠT ĐỘNG!"
def run(): app.run(host='0.0.0.0', port=8080)
def keep_alive(): threading.Thread(target=run).start()

keep_alive()
bot.run(TOKEN)
                          
