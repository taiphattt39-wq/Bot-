import discord
from discord import app_commands
from discord.ext import commands
from datetime import datetime
from flask import Flask
import threading
import aiohttp

# ===================== CẤU HÌNH =====================
TOKEN = "TOKEN"
API_KEY_GEMINI ="API"
ID_CHU_BOT = 1479375774711549996
# =====================================================

intents = discord.Intents.all()
bot = commands.Bot(command_prefix="/", intents=intents)

def la_chu_bot(user):
    return user.id == ID_CHU_BOT

# ===================== 📢 LỆNH /SAY =====================
@bot.tree.command(name="say", description="📢 Bot nói thay bạn")
async def say(interaction: discord.Interaction, noi_dung: str):
    if not la_chu_bot(interaction.user):
        return await interaction.response.send_message("❌ CHỈ CHỦ BOT MỚI ĐƯỢC!", ephemeral=True)
    await interaction.response.send_message("✅ Đã gửi!", ephemeral=True)
    await interaction.channel.send(noi_dung)

# ===================== 🤖 PING → AI TRẢ LỜI =====================
@bot.event
async def on_message(message):
    if message.author.bot: return
    nd = message.content.strip()

    if bot.user.mentioned_in(message):
        try:
            await message.channel.typing()
            cau_hoi = nd.replace(f"<@{bot.user.id}>", "").strip()
            if not cau_hoi:
                cau_hoi = "Chào bạn, giới thiệu ngắn gọn về bản thân"

            url = f"https://generativelanguage.googleapis.com/v1/models/gemini-1.5-flash:generateContent?key={API_KEY_GEMINI}"
            async with aiohttp.ClientSession() as session:
                async with session.post(url, json={
                    "contents": [{"parts": [{"text": cau_hoi}]}]
                }) as resp:
                    data = await resp.json()
                    tra_loi = data["candidates"][0]["content"]["parts"][0]["text"]

            if len(tra_loi) > 1900:
                for p in [tra_loi[i:i+1900] for i in range(0, len(tra_loi), 1900)]:
                    await message.channel.send(p)
            else:
                await message.channel.send(tra_loi)
        except Exception as e:
            await message.channel.send(f"❌ Lỗi: {str(e)}")

